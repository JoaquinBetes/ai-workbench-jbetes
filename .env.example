# Copiá este archivo como .env y ajustá los valores si hace falta.

# Dónde está Ollama.
#   Desarrollo (backend corriendo directo en el servidor): http://localhost:11434
#   Docker (lo setea docker-compose.yml automáticamente):  http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Postgres (con pgvector). Docker Compose usa estos valores para crear la base;
# si no los cambiás, quedan workbench / workbench / workbench.
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench
POSTGRES_DB=workbench

# Para desarrollar fuera de Docker (backend con uv run), con la base levantada por
# `docker compose up -d db`, que publica el puerto 5432 solo en el servidor:
DATABASE_URL=postgresql+asyncpg://workbench:workbench@localhost:5432/workbench

# Modelo de embeddings para la similitud semántica (bajalo con: ollama pull qwen3-embedding:0.6b)
MODELO_EMBEDDINGS=qwen3-embedding:0.6b
